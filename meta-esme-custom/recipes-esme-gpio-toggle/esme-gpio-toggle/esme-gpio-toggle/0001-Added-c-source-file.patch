From: Yvan Demelin <yvan.demelin@esme.fr>
Date: Wed, 19 Nov 2025 13:38:20 +0100
Subject: [PATCH] Added c source file

---
 esme-gpio-toggle.c | 51 ++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 51 insertions(+)
 create mode 100644 esme-gpio-toggle.c

diff --git a/esme-gpio-toggle.c b/esme-gpio-toggle.c
new file mode 100644
index 0000000..41532c9
--- /dev/null
+++ b/esme-gpio-toggle.c
@@ -0,0 +1,51 @@
+#include <gpiod.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define GPIO_CHIP "/dev/gpiochip0"
+
+int main (int argc, char *argv[]){
+
+	struct gpiod_chip *chip;
+	struct gpiod_line *line;
+	int value = 0;
+
+	int gpio_line = 26;
+
+	if (argc >= 3 && strcmp(argv[1], "--gpio") == 0) {
+		gpio_line = atoi(argv[2]);
+	} 
+
+	chip = gpiod_chip_open(GPIO_CHIP);
+	if (!chip) {
+		perror("gpiod_chip_open, error");
+		return 1;
+	}
+
+	line = gpiod_chip_get_line(chip, gpio_line);
+	if (!line){
+		perror("gpiod_line_chip_open, error");
+		gpiod_chip_close(chip);
+		return 1;
+	}
+
+	if (gpiod_line_request_output(line,"gpio-toggle",0) < 0){
+		perror("Output request failed!");
+		gpiod_chip_close(chip);
+		return 1;
+	}
+
+	while (1){
+		value = !value;
+		gpiod_line_set_value(line, value);
+		printf("GPI0%d set to %d\n", gpio_line, value);
+		sleep(1);
+	}
+
+	gpiod_line_release(line);
+	gpiod_chip_close(chip);
+
+	return 0;
+}
